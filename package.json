{
  "name": "therapy-sculpt",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:clinical": "pnpm --filter @therapy-sculpt/clinical-core test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @therapy-sculpt/database db:generate",
    "db:migrate": "pnpm --filter @therapy-sculpt/database db:migrate",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20.0.0", "pnpm": ">=9.0.0" }
}