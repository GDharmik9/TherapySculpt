# ==============================================================================
# TherapySculpt - Production Environment Variables Blueprint
# Target Cloud: Microsoft Azure | Region: UAE North (uaenorth)
# Regulatory Compliance: UAE Federal Law No. 2 of 2019 (Art. 13) | DoH ADHICS v2
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & LOCALIZATION
# ------------------------------------------------------------------------------
NODE_ENV=production
UAE_REGION=uaenorth
TZ=Asia/Dubai

# ------------------------------------------------------------------------------
# 2. NETWORKING & PORTS
# ------------------------------------------------------------------------------
# API Server runs on port 4000; Next.js web applications run on port 3000
PORT=4000
HOST=0.0.0.0
HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# 3. DATABASE (Azure Database for PostgreSQL Flexible Server)
# Mandatory: SSL enabled (?sslmode=require) and hosted strictly in uaenorth
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://tsadmin:<STRONG_PASSWORD_HERE>@psql-therapysculpt-uaenorth.postgres.database.azure.com:5432/therapysculpt?sslmode=require
DATABASE_DIRECT_URL=postgresql://tsadmin:<STRONG_PASSWORD_HERE>@psql-therapysculpt-uaenorth.postgres.database.azure.com:5432/therapysculpt?sslmode=require

# ------------------------------------------------------------------------------
# 4. CACHE & BACKGROUND QUEUES (Azure Managed Redis / Redis Enterprise)
# Mandatory: TLS enabled (rediss://), Port 10000, UAE North
# ------------------------------------------------------------------------------
REDIS_URL=rediss://:<AZURE_REDIS_PRIMARY_KEY>@redis-therapysculpt-uaenorth.uaenorth.redisenterprise.cache.azure.net:10000

# ------------------------------------------------------------------------------
# 5. CROSS-ORIGIN RESOURCE SHARING (CORS)
# Comma-separated list of allowed origins (Next.js portals)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://ca-web-patient.<unique-id>.uaenorth.azurecontainerapps.io,https://ca-web-clinician.<unique-id>.uaenorth.azurecontainerapps.io,https://ca-web-admin.<unique-id>.uaenorth.azurecontainerapps.io,https://patient.therapysculpt.ae,https://clinician.therapysculpt.ae,https://admin.therapysculpt.ae

# ------------------------------------------------------------------------------
# 6. PUBLIC NEXT.JS ENVIRONMENT VARIABLES (Inlined at Build Time)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://ca-api-server.<unique-id>.uaenorth.azurecontainerapps.io
NEXT_PUBLIC_UAE_REGION=uaenorth
NEXT_TELEMETRY_DISABLED=1

# ------------------------------------------------------------------------------
# 7. SECURITY, SESSIONS & UAE PASS IDENTITY FEDERATION
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_64_character_hex_or_base64_secret_key_minimum
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_separate_64_character_hex_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# UAE PASS National Identity Provider
UAE_PASS_ENVIRONMENT=production
UAE_PASS_CLIENT_ID=your_uae_pass_client_id_here
UAE_PASS_CLIENT_SECRET=your_uae_pass_client_secret_here
UAE_PASS_REDIRECT_URI=https://ca-api-server.<unique-id>.uaenorth.azurecontainerapps.io/auth/uae-pass/callback

# ------------------------------------------------------------------------------
# 8. CLINICAL SAFETY & CRISIS DISPATCH
# ------------------------------------------------------------------------------
# Emergency webhook for immediate triage nurse paging upon Gate 2 C-SSRS positivity
CRISIS_DISPATCH_WEBHOOK_URL=https://api.therapysculpt.ae/internal/crisis/dispatch
EMERGENCY_DISPATCH_SLA_MINUTES=15
UAE_NATIONAL_AMBULANCE_NUMBER=998
UAE_POLICE_EMERGENCY_NUMBER=999

# ------------------------------------------------------------------------------
# 9. HEALTH INFORMATION EXCHANGE (HIE) INTEGRATIONS
# ------------------------------------------------------------------------------
# Abu Dhabi Health Data Services (Malaffi) FHIR R4 Endpoint
MALAFFI_FHIR_BASE_URL=https://api.malaffi.ae/v1/fhir/r4
MALAFFI_CLIENT_ID=your_malaffi_client_id
MALAFFI_CLIENT_SECRET=your_malaffi_client_secret

# Dubai Health Authority (NABIDH) FHIR Endpoint
NABIDH_FHIR_BASE_URL=https://api.nabidh.ae/v1/fhir/r4
NABIDH_CLIENT_ID=your_nabidh_client_id
NABIDH_CLIENT_SECRET=your_nabidh_client_secret

# ------------------------------------------------------------------------------
# 10. TAMPER-EVIDENT AUDIT RETENTION (ADHICS v2 25-Year Rule)
# ------------------------------------------------------------------------------
AUDIT_RETENTION_YEARS=25
TAMPER_CHAIN_SALT=replace_with_cryptographic_hash_salt_for_sha256_audit_chain
